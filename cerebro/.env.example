# Cérebro Navesa — copie para cerebro/.env (fora do git) e preencha.
# NUNCA coloque aqui a service_role do Supabase nem ANTHROPIC_API_KEY:
# o LLM usa o login da assinatura feito com /login dentro do container.

# Tokens Bearer por perfil, "perfil:token" separados por vírgula (mín. 32 caracteres cada).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# O token do perfil web vai em CEREBRO_TOKEN no .env.local do site.
CEREBRO_TOKENS=web:troque-por-64-hex

# Role somente leitura da migration 051, pelo pooler (Supabase > Connect > Session pooler).
# Usuário no pooler: cerebro_leitor.<ref-do-projeto>. Senha definida no SQL Editor (ver README).
SUPABASE_DB_URL=postgresql://cerebro_leitor.REF:SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres

# TLS do banco: VERIFICADO por padrão. A imagem já traz a CA do Supabase e define
# SUPABASE_DB_CA_FILE=/srv/cerebro/certs/supabase-prod-ca-2021.crt (não precisa mexer).
# Desligar a verificação só para diagnóstico, de forma explícita:
# SUPABASE_DB_TLS_INSEGURO=1

# Opcionais (defaults do doc da arquitetura)
# CEREBRO_MAX_CONC=2
# CEREBRO_FILA_MAX=4
# CEREBRO_FILA_ESPERA_MS=15000
# CEREBRO_TIMEOUT_MS=110000   # contado da chegada do request (inclui fila)
# CEREBRO_CACHE_TTL_MS=300000
# CEREBRO_MAX_TURNS=12
# CEREBRO_MODELO_RAPIDO=claude-haiku-5-5
# CEREBRO_MODELO_AVANCADO=claude-sonnet-5-5

# Plano B do login (doc §4.4 opção B): token de `claude setup-token` no host.
# Fica visível em `docker inspect`; prefira o /login no volume.
# CLAUDE_CODE_OAUTH_TOKEN=
