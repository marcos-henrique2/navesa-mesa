# Supabase — get from your project at https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY-HERE
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY-HERE

# ─── Chat IA ───────────────────────────────────────────────────────────────
# Defina UMA ou MAIS das chaves abaixo. A rota /api/chat tenta na ordem:
#   1. DeepSeek  → 2. Groq  → 3. Gemini  → 4. Anthropic
# Se um provider falhar (quota/erro), cai pro próximo automaticamente.
#
# DeepSeek — PRIMEIRO da fila, barato e rápido
# Pegue em https://platform.deepseek.com
# DEEPSEEK_API_KEY=sk-YOUR-DEEPSEEK-KEY-HERE
#
# Groq — segundo da fila, ultra rápido, free tier generoso
# Pegue em https://console.groq.com
# GROQ_API_KEY=gsk_YOUR-GROQ-KEY-HERE
#
# Google Gemini — terceiro da fila, 1.500 req/dia grátis
# Pegue em https://aistudio.google.com/apikey (clica em "Create API key")
GOOGLE_GENERATIVE_AI_API_KEY=YOUR-GEMINI-KEY-HERE
#
# Anthropic Claude — fallback final, qualidade superior (~US$ 0,01 por mensagem)
# Pegue em https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-YOUR-KEY-HERE

# FIPE API (Parallelum — gratuita, sem chave)
FIPE_API_URL=https://parallelum.com.br/fipe/api/v1

# ─── Rate limit do /api/chat (Upstash Redis) ──────────────────────────────
# Opcional: se não setar, rate limit fica DESABILITADO (sistema funciona).
# Como configurar:
#   1. Conta grátis em https://console.upstash.com
#   2. Create Database → Redis (qualquer região, free tier dá 10k req/dia)
#   3. Copie REST URL + REST TOKEN da aba "REST API"
#   4. Setar aqui e também no Vercel Project Settings → Environment Variables
# UPSTASH_REDIS_REST_URL=https://YOUR-DB.upstash.io
# UPSTASH_REDIS_REST_TOKEN=YOUR-TOKEN-HERE
